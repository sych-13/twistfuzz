# Firebase Web SDK public configuration (not the admin service account)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Supabase public project URL and ANON/publishable key ONLY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Edge function base URL; NEVER expose service_role or secret API keys
VITE_ROLE_FUNCTION_NAME=resolve-role
# Keep false until the intended development backend, RLS and Admin MFA/recovery pass integration validation.
# This is a frontend availability gate only, never an authorization control.
VITE_AUTH_INTEGRATION_READY=false
